# ==========================================
# BRAINWAVE CUSTOM EMPLOYEE PORTAL CONFIG
# ==========================================

PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# For local Docker: postgresql://postgres:postgrespassword@localhost:5432/brainwave_portal
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/brainwave_portal

# Authentication & Session
JWT_SECRET=brainwave_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=30m

# Zoho OAuth2 & Backend Service Account Credentials
# (Leave blank for Simulation / Demo Mode)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Configurable Zoho Region Domains & Service URLs
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com

# Portal Launch URLs (for Employee redirection)
ZOHO_PEOPLE_URL=https://people.zoho.com
ZOHO_CRM_URL=https://crm.zoho.com
ZOHO_DESK_URL=https://desk.zoho.com
ZOHO_BOOKS_URL=https://books.zoho.com

# Contextual Organization IDs (Required for Books & Desk APIs)
ZOHO_BOOKS_ORG_ID=
ZOHO_DESK_ORG_ID=
